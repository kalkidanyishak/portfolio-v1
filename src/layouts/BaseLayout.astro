---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  noindex?: boolean;
  bodyClass?: string;
  htmlClass?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  noindex = false,
  bodyClass = '',
  htmlClass = '',
  structuredData,
} = Astro.props;

const fallbackSite = new URL('https://resume-aby.pages.dev');
const siteOrigin = Astro.site ?? fallbackSite;
const canonical = new URL(Astro.url.pathname, siteOrigin);
const ogImage = new URL('/og/og-image.jpg', siteOrigin);
const fullTitle = title.includes('Kalkidan') ? title : `${title} · Kalkidan Yishak Zerihun`;
---

<!doctype html>
<html lang="en" class={htmlClass}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#DEDBD4" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Kalkidan Yishak Zerihun" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/icon-180.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/spline-sans-mono-latin.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Kalkidan Yishak Zerihun" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Kalkidan Yishak Zerihun, fullstack developer. Thoughtful interfaces. Working systems."
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="scroll-progress" data-progress aria-hidden="true"></div>
    <div class="surface-atmosphere" aria-hidden="true"></div>
    <div class="surface-grain" aria-hidden="true"></div>
    <div class="surface-contours" aria-hidden="true"></div>
    <SiteHeader />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
