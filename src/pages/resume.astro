---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { resume } from '../data/resume';
import { featuredProject, supportingProjects, explorations } from '../data/projects';

const mercy = supportingProjects.find((project) => project.id === 'mercyplc')!;
const epsirs = supportingProjects.find((project) => project.id === 'epsirs')!;
const cuamm = supportingProjects.find((project) => project.id === 'cuamm')!;

const pageDescription =
  'Résumé of Kalkidan Yishak Zerihun, a fullstack developer in Addis Ababa working with Next.js, PostgreSQL, REST APIs and Linux deployment.';
---

<BaseLayout
  title="Résumé · Kalkidan Yishak Zerihun"
  description={pageDescription}
  ogTitle="Kalkidan Yishak Zerihun · Résumé"
  ogDescription="Fullstack developer in Addis Ababa. Next.js, PostgreSQL, REST APIs and production deployment."
  noindex={false}
>
  <article class="resume-page">
    <div class="shell">
      <div class="resume-toolbar no-print">
        <a href="/">← Back to portfolio</a>
        <div class="resume-toolbar__actions">
          <span class="resume-toolbar__note">A print-friendly version of the source résumé.</span>
          <button class="resume-print js-only" type="button" data-print-resume>
            Print / save PDF
            <span aria-hidden="true">↗</span>
          </button>
        </div>
      </div>

      <header class="resume-header" data-reveal>
        <p class="mono resume-kicker">Curriculum vitae / 2026</p>
        <h1>{site.name}</h1>
        <p class="resume-role">Fullstack Developer</p>

        <address class="resume-contact">
          <span>{site.location}</span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href="tel:+251909411199">+251 909 411 199</a>
          <a href={site.links.github} target="_blank" rel="noopener noreferrer">GitHub<span class="sr-only"> (opens in a new tab)</span></a>
          <a href={site.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
          <a href={site.links.telegram} target="_blank" rel="noopener noreferrer">Telegram<span class="sr-only"> (opens in a new tab)</span></a>
        </address>
      </header>

      <p class="resume-summary" data-glare data-reveal>{resume.summary}</p>

      <div class="resume-layout">
        <div class="resume-main">
          <section class="resume-section" data-glare data-reveal aria-labelledby="experience-heading">
            <div class="resume-section__head">
              <h2 id="experience-heading">Projects &amp; work experience</h2>
            </div>

            <article class="resume-project">
              <div class="resume-entry__top">
                <div>
                  <h3>Kerawi International Hotel</h3>
                  <p class="resume-entry__org">Sabeh Systems</p>
                </div>
                <p class="mono">2026</p>
              </div>
              <p class="resume-entry__role">Fullstack Developer</p>
              <ul class="resume-bullets">
                <li>Architected and built complete guest-facing booking interfaces and administrative hotel management systems.</li>
                <li>Designed PostgreSQL database schemas, integrated REST APIs and managed server deployment pipelines.</li>
              </ul>
              <p class="resume-stack"><span class="mono">Stack</span> {featuredProject.stack.join(', ')}</p>
              <a class="resume-project-link" href={featuredProject.liveUrl} target="_blank" rel="noopener noreferrer">kerawiinternationalhotel.com <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
            </article>

            <article class="resume-project">
              <div class="resume-entry__top">
                <div>
                  <h3>Mercy PLC: Restaurant &amp; Bakery Systems</h3>
                  <p class="resume-entry__org">Mercy PLC · via Sabeh Systems</p>
                </div>
                <p class="mono">2026 to Present</p>
              </div>
              <p class="resume-entry__role">Developer &amp; Maintainer</p>
              <ul class="resume-bullets">
                <li>Built the Mercy Fruit Salad restaurant management system end to end: POS and order flow, kitchen display, sales analytics, menu and inventory, staff authentication and roles, database and deployment.</li>
                <li>Added product catalogue and admin dashboard features to Buhey Bakery’s Next.js and Django platform, and manage ongoing bug fixes, API changes, releases and server operations.</li>
              </ul>
              <p class="resume-stack"><span class="mono">Stack</span> {mercy.stack.join(', ')}</p>
              <a class="resume-project-link" href={mercy.liveUrl} target="_blank" rel="noopener noreferrer">mercyplc.org <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
            </article>

            <article class="resume-project">
              <div class="resume-entry__top">
                <div>
                  <h3>ePSIRS: Electronic Patient Safety Incident Reporting System</h3>
                  <p class="resume-entry__org">A RC ICT</p>
                </div>
                <p class="mono">2026 to Present</p>
              </div>
              <p class="resume-entry__role">Frontend &amp; Partial Backend Developer</p>
              <ul class="resume-bullets">
                <li>Developed platform interfaces for reporting patient safety incidents, near misses and unsafe conditions to strengthen Ethiopia’s national health system.</li>
                <li>Engineered primary frontend components in Next.js, developed C# .NET API integrations and supported partial system deployments.</li>
              </ul>
              <p class="resume-stack"><span class="mono">Stack</span> Next.js, C# .NET, REST API integration</p>
              <a class="resume-project-link" href={epsirs.liveUrl} target="_blank" rel="noopener noreferrer">epsirs.arclabs.et <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
            </article>

            <article class="resume-project">
              <div class="resume-entry__top">
                <div>
                  <h3>CUAMM EMR Dashboard</h3>
                  <p class="resume-entry__org">A RC ICT</p>
                </div>
                <p class="mono">2025</p>
              </div>
              <p class="resume-entry__role">Frontend Developer</p>
              <ul class="resume-bullets">
                <li>Built interactive health monitoring dashboards visualizing key medical services across supported healthcare facilities and IDP sites.</li>
                <li>Integrated analytics for OPD visits, maternal health, nutrition, immunization, NCDs and family planning; managed live application deployment.</li>
              </ul>
              <p class="resume-stack"><span class="mono">Stack</span> {cuamm.stack.join(', ')}</p>
              <a class="resume-project-link" href={cuamm.liveUrl} target="_blank" rel="noopener noreferrer">cuammethiopia-emr.org <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
            </article>

            <article class="resume-project">
              <div class="resume-entry__top">
                <div>
                  <h3>Better Hack 2025</h3>
                  <p class="resume-entry__org">Hackathon project</p>
                </div>
                <p class="mono">2025</p>
              </div>
              <p class="resume-bullets resume-bullets--single">Hackathon project showcasing config-first software development.</p>
              <div class="resume-inline-links">
                <a href={explorations[1].url} target="_blank" rel="noopener noreferrer">Live demo <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
              </div>
            </article>

            <article class="resume-project">
              <div class="resume-entry__top">
                <div>
                  <h3>Agricultural Data Platform</h3>
                  <p class="resume-entry__org">AASTU · Final-year project · Electrical and Computer Engineering</p>
                </div>
              </div>
              <p class="resume-bullets resume-bullets--single">Designed an AI-driven agricultural platform incorporating Machine Learning, RAG and LLMs; integrated backend REST APIs and executed deployment.</p>
              <p class="resume-stack"><span class="mono">Stack</span> AdonisJS, TypeScript, Python, ML, RAG, LLM, PostgreSQL, REST APIs</p>
              <a class="resume-project-link" href={explorations[0].url} target="_blank" rel="noopener noreferrer">agri-data-iota.vercel.app <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
            </article>
          </section>

          <section class="resume-section" data-glare data-reveal aria-labelledby="leadership-heading">
            <div class="resume-section__head">
              <h2 id="leadership-heading">Leadership &amp; mentorship</h2>
            </div>
            {resume.leadership.map((item) => (
              <article class="resume-entry">
                <div class="resume-entry__top">
                  <div>
                    <h3>{item.role}</h3>
                    <p class="resume-entry__org">{item.organization}</p>
                  </div>
                  <p class="mono">{item.dates}</p>
                </div>
                <p class="resume-entry__description">{item.description}</p>
                {item.stack && <p class="resume-stack"><span class="mono">Stack</span> {item.stack}</p>}
              </article>
            ))}
          </section>
        </div>

        <aside class="resume-side" aria-label="Skills, education, and recognition">
          <section class="resume-section" data-glare data-reveal aria-labelledby="skills-heading">
            <div class="resume-section__head">
              <h2 id="skills-heading">Technical skills</h2>
            </div>
            <dl class="resume-skills">
              {resume.skillGroups.map((group) => (
                <div>
                  <dt>{group.label}</dt>
                  <dd>{group.items.join(', ')}</dd>
                </div>
              ))}
            </dl>
          </section>

          <section class="resume-section" data-glare data-reveal aria-labelledby="education-heading">
            <div class="resume-section__head">
              <h2 id="education-heading">Education</h2>
            </div>
            <div class="resume-entry">
              <p class="mono">{resume.education.dates}</p>
              <h3>{resume.education.qualification}</h3>
              <p class="resume-entry__org">{resume.education.institution}</p>
            </div>
          </section>

          <section class="resume-section" data-glare data-reveal aria-labelledby="recognition-heading">
            <div class="resume-section__head">
              <h2 id="recognition-heading">Hackathons &amp; recognition</h2>
            </div>
            <ul class="resume-recognition">
              {resume.recognitions.map((item) => (
                <li>
                  <h3>{item.name}</h3>
                  {item.detail && <p>{item.detail}</p>}
                  <div class="resume-recognition__links">
                    {item.url && (
                      <a href={item.url} target="_blank" rel="noopener noreferrer">Event site <span aria-hidden="true">↗</span><span class="sr-only"> for {item.name} (opens in a new tab)</span></a>
                    )}
                    {item.certificate && (
                      <a href={item.certificate} target="_blank" rel="noopener noreferrer">Certificate <span aria-hidden="true">↗</span><span class="sr-only"> for {item.name} (opens in a new tab)</span></a>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </section>

          <section class="resume-section" data-glare data-reveal aria-labelledby="focus-heading">
            <div class="resume-section__head">
              <h2 id="focus-heading">Interests &amp; focus areas</h2>
            </div>
            <ul class="resume-focus">
              {resume.focus.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        </aside>
      </div>

      <footer class="resume-footer no-print" data-reveal>
        <p>Source résumé preserved. This page is designed to print cleanly.</p>
        <a href="/">Return to the portfolio <span aria-hidden="true">↗</span></a>
      </footer>
    </div>
  </article>
</BaseLayout>

<style is:global>
  .js .js-only {
    display: inline-flex;
  }

  .js-only {
    display: none;
  }

  .resume-page {
    padding-block:
      calc(var(--header-height) + clamp(24px, 3.4vw, 44px))
      clamp(60px, 8vw, 110px);
  }

  .resume-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
    font-size: 0.78rem;
  }

  .resume-toolbar > a {
    display: inline-flex;
    min-height: 38px;
    align-items: center;
    color: var(--muted);
    font-weight: 600;
    text-decoration: none;
  }

  .resume-toolbar > a:hover {
    color: var(--accent-deep);
  }

  .resume-toolbar__actions {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .resume-toolbar__note {
    color: var(--muted);
    font-size: 0.72rem;
  }

  .resume-print {
    min-height: 42px;
    align-items: center;
    gap: 8px;
    padding: 0 18px;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: var(--raise-sm);
    color: var(--ink);
    font-size: 0.76rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      box-shadow 220ms var(--ease),
      color 180ms ease;
  }

  .resume-print:hover {
    color: var(--accent-deep);
  }

  .resume-print:active {
    box-shadow: var(--sink-sm);
  }

  .resume-header {
    padding-block: clamp(36px, 6vw, 72px) 0;
  }

  .resume-kicker {
    margin-bottom: 16px;
    color: var(--accent);
  }

  .resume-header h1 {
    font-size: clamp(3.2rem, 7vw, 6.4rem);
    letter-spacing: -0.035em;
    line-height: 0.95;
  }

  .resume-role {
    margin-top: 18px;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .resume-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 7px 22px;
    margin-top: 26px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.78rem;
    font-style: normal;
  }

  .resume-contact a {
    display: inline-flex;
    min-height: 28px;
    align-items: center;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0 1px;
    text-decoration: none;
    transition:
      background-size 280ms var(--ease),
      color 180ms ease;
  }

  .resume-contact a:hover {
    background-size: 100% 1px;
    color: var(--accent-deep);
  }

  .resume-summary {
    max-width: 105ch;
    margin-top: clamp(22px, 3vw, 34px);
    padding: var(--pad-card);
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 18px;
    background: var(--surface);
    box-shadow: var(--raise-sm);
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .resume-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(300px, 0.72fr);
    gap: clamp(40px, 6vw, 80px);
    padding-top: clamp(36px, 4.4vw, 58px);
  }

  .resume-section + .resume-section {
    margin-top: clamp(36px, 4.5vw, 58px);
  }

  .resume-section__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--line-strong);
  }

  .resume-section h2 {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .resume-entry,
  .resume-project {
    padding-block: 19px;
    border-top: 1px solid var(--line);
    break-inside: avoid;
  }

  .resume-section .resume-entry:first-of-type,
  .resume-section .resume-project:first-of-type {
    border-top: 0;
    padding-top: 6px;
  }

  .resume-entry__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
  }

  .resume-entry__top > .mono {
    flex: none;
    padding-top: 4px;
    color: var(--quiet);
    font-size: 0.58rem;
    white-space: nowrap;
  }

  .resume-entry h3,
  .resume-project h3 {
    font-family: var(--font-sans);
    font-size: 0.96rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .resume-project h3 {
    max-width: 45ch;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.1vw, 1.95rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .resume-entry__org {
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .resume-entry__role {
    margin-top: 8px;
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  .resume-bullets {
    display: grid;
    gap: 7px;
    margin-top: 14px;
  }

  .resume-bullets li {
    display: grid;
    grid-template-columns: 14px 1fr;
    gap: 7px;
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.58;
  }

  .resume-bullets li::before {
    content: '•';
    color: var(--accent);
    line-height: 1.5;
  }

  .resume-bullets--single {
    margin-top: 8px;
  }

  .resume-stack {
    max-width: 72ch;
    margin-top: 13px;
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.55;
  }

  .resume-stack .mono {
    margin-right: 6px;
    color: var(--ink);
    font-size: 0.56rem;
  }

  .resume-project-link,
  .resume-inline-links a {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    gap: 5px;
    margin-top: 4px;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0 1px;
    color: var(--accent-deep);
    font-size: 0.73rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-size 280ms var(--ease),
      color 180ms ease;
  }

  .resume-project-link:hover,
  .resume-inline-links a:hover {
    background-size: 100% 1px;
  }

  .resume-inline-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin-top: 4px;
  }

  .resume-entry__description {
    margin-top: 9px;
    color: var(--muted);
    font-size: 0.84rem;
  }

  .resume-side .resume-section {
    padding: var(--pad-card);
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 18px;
    background: var(--surface);
    box-shadow: var(--raise-sm);
  }

  .resume-side .resume-section + .resume-section {
    margin-top: 18px;
  }

  .resume-side .resume-section__head {
    margin-bottom: 13px;
    padding-top: 0;
    border-top: 0;
  }

  .resume-skills {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .resume-skills > div {
    padding-block: 12px;
    border-bottom: 1px solid var(--line);
  }

  .resume-skills > div:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .resume-skills dt {
    margin-bottom: 4px;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .resume-skills dd {
    color: var(--muted);
    font-size: 0.76rem;
    line-height: 1.55;
  }

  .resume-side .resume-entry {
    padding-block: 0;
    border-top: 0;
  }

  .resume-side .resume-entry h3 {
    margin-top: 5px;
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.15;
  }

  .resume-recognition {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .resume-recognition li {
    padding-block: 13px;
    border-bottom: 1px solid var(--line);
  }

  .resume-recognition li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .resume-recognition h3 {
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .resume-recognition p {
    margin-top: 3px;
    color: var(--muted);
    font-size: 0.74rem;
    line-height: 1.5;
  }

  .resume-recognition__links {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 16px;
  }

  .resume-recognition a {
    display: inline-flex;
    min-height: 28px;
    align-items: center;
    gap: 4px;
    margin-top: 2px;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0 1px;
    color: var(--accent-deep);
    font-size: 0.67rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-size 280ms var(--ease),
      color 180ms ease;
  }

  .resume-recognition a:hover {
    background-size: 100% 1px;
  }

  .resume-focus {
    display: grid;
    gap: 7px;
    color: var(--muted);
    font-size: 0.76rem;
  }

  .resume-focus li {
    display: grid;
    grid-template-columns: 14px 1fr;
    gap: 7px;
  }

  .resume-focus li::before {
    content: '•';
    color: var(--accent);
  }

  .resume-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 28px;
    margin-top: clamp(50px, 6vw, 80px);
    padding-top: 18px;
    border-top: 1px solid var(--line-strong);
    color: var(--muted);
    font-size: 0.76rem;
  }

  .resume-footer a {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    color: var(--ink);
    font-weight: 600;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }

  @media (max-width: 900px) {
    .resume-layout {
      grid-template-columns: 1fr;
      gap: 42px;
    }

    .resume-toolbar__note {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .resume-toolbar {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }

    .resume-toolbar__actions {
      align-self: stretch;
      justify-content: flex-end;
    }

    .resume-header h1 {
      font-size: clamp(3rem, 14vw, 4.6rem);
    }

    .resume-entry__top {
      flex-direction: column;
      gap: 7px;
    }

    .resume-entry__top > .mono {
      padding-top: 0;
      order: -1;
    }

    .resume-project h3 {
      font-size: 1.5rem;
    }

    .resume-footer {
