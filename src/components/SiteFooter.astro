---
import { navigation, site, socials } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-top">
      <p class="footer-line">Thoughtful interfaces.<br /><span>Working systems.</span></p>
      <p class="footer-note">Fullstack developer<br />Addis Ababa, Ethiopia</p>
    </div>

    <div class="footer-grid">
      <nav class="footer-links" aria-label="Footer">
        {navigation.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
        <a href="/resume/">Résumé</a>
      </nav>
      <div class="footer-links">
        {socials.map((social) => (
          <a href={social.href} target="_blank" rel="noopener noreferrer">
            {social.label}<span class="sr-only"> (opens in a new tab)</span>
          </a>
        ))}
      </div>
      <div class="footer-contact">
        <p class="footer-contact__label">Start a conversation</p>
        <a class="footer-email" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>

    <div class="footer-base">
      <p>© {year} {site.name}</p>
      <a href="#main-content">Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    --footer-dark: #171613;
    --footer-light: rgba(255, 255, 255, 0.055);
    position: relative;
    padding-top: clamp(64px, 9vw, 108px);
    background:
      radial-gradient(ellipse 90% 70% at 12% -4%, rgba(255, 255, 255, 0.065), transparent 58%),
      radial-gradient(ellipse 80% 80% at 102% 106%, rgba(150, 56, 31, 0.12), transparent 62%),
      var(--night);
    color: var(--on-dark);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      inset 0 36px 70px rgba(0, 0, 0, 0.18);
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .site-footer::before {
    position: absolute;
    inset: 0;
    background-image: url('/images/bg-texture.webp');
    background-position: center;
    background-size: cover;
    content: '';
    mix-blend-mode: soft-light;
    opacity: 0.42;
    pointer-events: none;
  }

  .site-footer > .shell {
    position: relative;
    z-index: 1;
  }

  @media (min-width: 1100px) {
    .site-footer {
      display: flex;
      min-height: 100svh;
      flex-direction: column;
      justify-content: center;
      padding-top: 0;
    }
  }

  .footer-top {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 28px 48px;
    padding-bottom: clamp(36px, 5vw, 56px);
    border-bottom: 1px solid var(--line-dark);
  }

  .footer-line {
    max-width: 18ch;
    font-size: clamp(2rem, 4.4vw, 3.6rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  .footer-line span {
    color: var(--on-dark-muted);
  }

  .footer-note {
    color: var(--on-dark-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 0.6fr 0.6fr 1.2fr;
    gap: 32px clamp(24px, 5vw, 72px);
    padding-block: clamp(32px, 4vw, 48px);
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    color: var(--on-dark-muted);
    font-size: 0.92rem;
  }

  .footer-links a {
    display: inline-flex;
    min-height: 38px;
    align-items: center;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0 1px;
    color: var(--on-dark-muted);
    text-decoration: none;
    transition:
      background-size 300ms var(--ease),
      color 180ms ease,
      transform 240ms var(--ease);
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    background-size: 100% 1px;
    color: var(--on-dark);
    transform: translateX(2px);
  }

  .footer-links a:focus-visible {
    outline-color: var(--on-dark);
  }

  .footer-contact {
    justify-self: end;
    width: min(100%, 360px);
  }

  .footer-contact__label {
    margin-bottom: 8px;
    color: var(--on-dark-muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer-email {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    padding: 0 20px;
    border-radius: 14px;
    background: var(--night-high);
    box-shadow:
      4px 4px 12px var(--footer-dark),
      -3px -3px 10px var(--footer-light);
    color: var(--on-dark);
    font-size: clamp(0.88rem, 1.2vw, 1rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
    text-decoration: none;
    transition:
      box-shadow 240ms var(--ease),
      color 180ms ease;
  }

  .footer-email:hover,
  .footer-email:focus-visible {
    box-shadow:
      inset 3px 3px 8px var(--footer-dark),
      inset -2px -2px 7px var(--footer-light);
    color: var(--accent-soft);
  }

  .footer-email:active {
    transform: translateY(1px);
  }

  .footer-email:focus-visible {
    outline-color: var(--on-dark);
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    padding-block: 22px max(22px, env(safe-area-inset-bottom));
    border-top: 1px solid var(--line-dark);
    color: var(--on-dark-muted);
    font-size: 0.8rem;
  }

  .footer-base a {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    gap: 6px;
    color: var(--on-dark-muted);
    text-decoration: none;
  }

  .footer-base a:hover,
  .footer-base a:focus-visible {
    color: var(--on-dark);
  }

  .footer-base a span {
    transition: transform 240ms var(--ease);
  }

  .footer-base a:hover span,
  .footer-base a:focus-visible span {
    transform: translateY(-2px);
  }

  .footer-base a:focus-visible {
    outline-color: var(--on-dark);
  }

  @media (max-width: 820px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-contact {
      grid-column: 1 / -1;
      justify-self: stretch;
      width: 100%;
    }

    .footer-email {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 520px) {
    .footer-top {
      align-items: flex-start;
      flex-direction: column;
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .footer-contact {
      grid-column: auto;
    }

    .footer-email {
      justify-content: flex-start;
    }
  }
</style>
